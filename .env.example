# Copy this file to .env and fill in your key. .env is git-ignored.

# Required for the AI assistant (Gemini free tier works). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: which Gemini model to use (default: gemini-3.5-flash)
# PAWPAL_MODEL=gemini-3.5-flash

# Optional: few-shot examples in the system prompt, on or off (default: on)
# PAWPAL_FEW_SHOT=on
